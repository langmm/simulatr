{
    "$type": "Models.Manager, Models",
    "CodeArray": [
        "using Models.Soils.Nutrients;",
        "using System.Linq;",
        "using System;",
        "using Models.Core;",
        "using Models.PMF;",
        "using Models.PMF.Interfaces;",
        "using Models.Soils;",
        "using Models.Surface;",
        "using Models.Soils.Nutrients;",
        "using Models.Utilities;",
        "using Models.Functions;",
        "using System.Text.Json;",
        "using System.IO;",
        "using System.Collections.Generic;",
        "",
        "using NetMQ;",
        "using NetMQ.Sockets;",
        "",
        "using APSIM.Shared.Utilities;",
        "",
        "namespace Models",
        "{",
        "    [Serializable]",
        "    public class Script : Model",
        "    {",
        "        [Link] Clock clock;",
        "        [Link] private Summary Summary;",
        "        Locator locator;",
        "        public void SetLocator(ILocator locator) => this.locator = locator;",
        "        public IStructure Structure { private get; set; }",
        "        [Link] private Zone zone;",
        "",
        "        [Description(\"Identifier\")]",
        "        public string Identifier { get; set;}",
        "",
        "        [NonSerialized]",
        "        private RequestSocket connection = null;",
        "",
        "        [EventSubscribe(\"StartOfSimulation\")]",
        "        private void OnSimulationCommencing(object sender, EventArgs e)",
        "        {",
        "           if (Identifier == \"<undefined>\") {",
        "               Console.WriteLine(\"Need an endpoint to connect to\");",
        "               Summary.WriteMessage(this, \"Need an endpoint to connect to\", MessageType.Error);",
        "               return;",
        "           } ",
        "           if (connection != null) {",
        "               TerminateOnError(\"Simulation re-initialized, probably by setting an initialization parameter\");",
        "           } else {",
        "               Console.WriteLine(\"Identifier=\" + Identifier);",
        "               Identifier = \"tcp://\" + Identifier;",
        "               connection = new RequestSocket(Identifier);",
        "               connection.SendFrame(\"connect\");",
        "               var msg = connection.ReceiveFrameString(); ",
        "               if (msg != \"ok\") { throw new Exception(\"Expected ok\"); }",
        "           }",
        "        }",
        "        ",
        "        [EventSubscribe(\"EndOfDay\")]",
        "        private void OnEndOfDay(object sender, EventArgs e)",
        "        {",
        "           if (connection == null) { return; }",
        "           bool moreToDo = true;",
        "           connection.SendFrame(\"paused\");",
        "           while (moreToDo) {",
        "             var msg = connection.ReceiveMultipartMessage();",
        "             //Console.WriteLine(\"Got {0} parts, first = {1}\", msg.FrameCount, msg[0].ConvertToString()); ",
        "             if (msg.FrameCount <= 0) { continue ; }",
        "              ",
        "             var command = msg[0].ConvertToString();",
        "             if (command == \"resume\") { ",
        "                moreToDo = false;",
        "                ",
        "             } else if (command == \"act\" && msg.FrameCount >= 2) {",
        "                 try {",
        "                     onDoCommand(msg);",
        "                     connection.SendFrame(\"ok\");",
        "                 } catch (Exception err) {",
        "                     RecoverableError(\"Error when carrying out action\", err);",
        "                     continue;",
        "                 }",
        "                 ",
        "             } else if (command == \"set\" && msg.FrameCount >= 3) {",
        "                 // set an apsim variable. ",
        "                 //  arg 1 is the variable path (eg \"[Nutrient].NO3.kgha\"), ",
        "                 //  arg 2 is the packed object                ",
        "                 bool setError = false;",
        "                 for (int i = 1; i < msg.FrameCount; i += 2 ) {",
        "                   string variableName = JsonSerializer.Deserialize<string>( msg[i].Buffer );",
        "                   ",
        "                   if (locator.Get(variableName) == null) {",
        "                      RecoverableError(\"Could not locate variable named \" + variableName);",
        "                      setError = true;",
        "                      break;",
        "                   }",
        "                   // See what type the apsim variable is",
        "                   var myType = locator.Get(variableName).GetType();",
        "                   //Console.WriteLine(\"Got set {0}, my type is {1}\", variableName, myType);",
        "                   ",
        "                   object value = JsonSerializer.Deserialize<object>( msg[i + 1].Buffer );",
        "                   //Console.WriteLine(\"Got set {0} of incoming type {1} ({2})\", variableName, value.GetType(), value);",
        "                   if (value.GetType().IsArray != myType.IsArray) {",
        "                      RecoverableError(\"Array/scalar mismatch for \" + variableName);",
        "                      setError = true;",
        "                      break;",
        "                   }",
        "                   ",
        "                   if (myType.IsArray) {",
        "                      Type myElementType = myType.GetElementType();",
        "                      Object[] values = (value as object[]);",
        "                      if (isNumeric(myElementType)) {",
        "                         var myValues = Array.ConvertAll(values, (e) => (double) e);",
        "                         locator.Set(variableName, myValues);",
        "                      } else if (isInteger(myElementType)) {",
        "                         var myValues = Array.ConvertAll(values, (e) => (int) e);",
        "                         locator.Set(variableName, myValues);",
        "                      } else if (isString(myElementType)) {",
        "                         var myValues = Array.ConvertAll(values, (e) => (string) e);",
        "                         locator.Set(variableName, myValues);",
        "                      } else {",
        "                         throw new Exception(\"Don't know what to do setting a \" + myElementType + \" variable\");",
        "                      }",
        "",
        "                      //Type myElementType = myType.GetElementType();",
        "                      //var values = Array.ConvertAll((object[])value, (e) => Convert.ChangeType(e, myElementType)) as System.Array;",
        "                      //Console.WriteLine(\"Doing set {0} of type {1} ({2}) = \", variableName, ",
        "                      //                  values.GetType(), values.GetType().GetElementType(),  ",
        "                      //                  values.GetValue(0).ToString());",
        "                      //locator.Set(variableName, values);",
        "                   } else {",
        "                      try {",
        "                          if (isNumeric(myType)) {",
        "                            double value_cast = JsonSerializer.Deserialize<double>( msg[i + 1].Buffer );",
        "                            locator.Set(variableName, value_cast);",
        "                          } else if (isInteger(myType)) {",
        "                            int value_cast = JsonSerializer.Deserialize<int>( msg[i + 1].Buffer );",
        "                            locator.Set(variableName, value_cast);",
        "                          } else if (isString(myType)) {",
        "                            string value_cast = JsonSerializer.Deserialize<string>( msg[i + 1].Buffer );",
        "                            locator.Set(variableName, value_cast);",
        "                          } else {",
        "                            locator.Set(variableName, Convert.ChangeType(value, myType));",
        "                          }",
        "                      } catch (Exception err) {",
        "                          RecoverableError(\"Error when setting \" + variableName, err);",
        "                          setError = true;",
        "                          break;",
        "                      }",
        "                   }",
        "                }",
        "                if (setError) {",
        "                   continue;",
        "                }",
        "                connection.SendFrame(\"ok\");",
        "                ",
        "             } else if (command == \"get\" && msg.FrameCount > 1) {",
        "                bool getError = false;",
        "                var values = new List<object>();",
        "                for (int i = 1; i < msg.FrameCount; i += 1 ) {",
        "                   string variableName = JsonSerializer.Deserialize<string>( msg[i].Buffer );",
        "                   object value = locator.Get(variableName);",
        "                   if (value == null) {",
        "                      RecoverableError(\"Could not locate variable named \" + variableName);",
        "                      getError = true;",
        "                      break;",
        "                   }",
        "                   if (value is IFunction function)",
        "                       value = function.Value();",
        "                   else if (value != null && (value.GetType().IsArray || value.GetType().IsClass))",
        "                   {",
        "                      try",
        "                      {",
        "                          value = ReflectionUtilities.Clone(value);",
        "                      }",
        "                      catch (Exception err)",
        "                      {",
        "                          throw new Exception($\"Cannot report variable \\\"{variableName}\\\": Variable is a non-reportable type: \\\"{value?.GetType()?.Name}\\\".\", err);",
        "                      }",
        "                   }",
        "                ",
        "                   if (value == null) {",
        "                      RecoverableError(\"Variable is null: \" + variableName);",
        "                      getError = true;",
        "                   }",
        "                   //Console.WriteLine(\"Got get '{0}' of type '{1}'\", variableName, value?.GetType()); ",
        "                   values.Add(value);",
        "                }",
        "                if (getError) {",
        "                   continue;",
        "                }",
        "                byte[] bytes = JsonSerializer.SerializeToUtf8Bytes(values);",
        "                //Console.WriteLine(\"Sending {0} bytes\", bytes.Length); ",
        "",
        "                connection.SendFrame(bytes);",
        "             } else {",
        "                throw new Exception(\"Expected resume/get/set/act, not '\" + command + \"'\");",
        "             }",
        "           }",
        "        }",
        "        ",
        "        [Link] Fertiliser Fertiliser;",
        "        [Link] Irrigation Irrigation;",
        "        [Link] SurfaceOrganicMatter SOM;",
        "",
        "        // Handle a command:",
        "        // nitrogen \"amount\" <double> \"type\" <string>",
        "        // sow \"crop_name\" <string> \"crop_variety\" <string> \"population\" <double> \"sowingDepth\" <double> \"rowSpacing\" <double> ",
        "        // harvest \"crop_name\" <string>",
        "        // irrigate \"amount\" <double>",
        "        // tillage \"type\" <string : (chisel|disc|planter|burn)>",
        "        // terminate",
        "        ",
        "        public void onDoCommand(NetMQMessage msg) {",
        "             // msg[0] is \"act\"",
        "             var cmd = JsonSerializer.Deserialize<string>( msg[1].Buffer);",
        "             if (cmd == \"fertilize\" || cmd == \"nitrogen\" || cmd == \"calcium\" || cmd == \"phosphorus\") {",
        "                 double FertAmount = 0;",
        "                 string FertType = \"NO3N\";",
        "                 double FertDepth = 0;",
        "                 double FertDepthBottom = 0;",
        "                 if (cmd == \"calcium\") {",
        "                   FertType = \"CalciteCA\";",
        "                 } else if (cmd == \"phosphorus\") {",
        "                   FertType = \"RockP\";",
        "                 }",
        "                 for (int i = 2; i < msg.FrameCount; i += 2 ) {",
        "                    var vname = JsonSerializer.Deserialize<string>( msg[i].Buffer);",
        "                    if ( vname == \"amount\" ) {",
        "                        FertAmount = JsonSerializer.Deserialize<double>( msg[i + 1].Buffer);",
        "                    } else if ( vname == \"type\" ) {",
        "                        FertType = JsonSerializer.Deserialize<string>( msg[i + 1].Buffer);",
        "                    } else if ( vname == \"depth\" ) {",
        "                        FertDepth = JsonSerializer.Deserialize<double>( msg[i + 1].Buffer);",
        "                    } else if ( vname == \"depthBottom\" ) {",
        "                        FertDepthBottom = JsonSerializer.Deserialize<double>( msg[i + 1].Buffer);",
        "                    }",
        "                 }",
        "                 if (FertAmount > 0) {",
        "                    Console.WriteLine(\"Applying Fertiliser, amt={0}, typ={1} \", FertAmount, FertType); ",
        "                    Fertiliser.Apply(FertAmount, FertType);",
        "                 }",
        "             } else if (cmd == \"sow\") {",
        "                 string cropName = \"\";",
        "                 string cultivarName = \"default\";",
        "                 double population = 5;",
        "                 double sowingDepth = 50;",
        "                 double rowSpacing = 1000;",
        "                 for (int i = 2; i < msg.FrameCount; i += 2 ) {",
        "                    var vname = JsonSerializer.Deserialize<string>( msg[i].Buffer);",
        "                    if ( vname == \"crop_name\" ) {",
        "                        cropName = JsonSerializer.Deserialize<string>( msg[i + 1].Buffer);",
        "                    } else  if ( vname == \"crop_variety\" ) {",
        "                        cultivarName = JsonSerializer.Deserialize<string>( msg[i + 1].Buffer);",
        "                    } else if ( vname == \"population\" ) {",
        "                        population = JsonSerializer.Deserialize<double>( msg[i + 1].Buffer);",
        "                    } else if ( vname == \"sowingDepth\" ) {",
        "                        sowingDepth = JsonSerializer.Deserialize<double>( msg[i + 1].Buffer);",
        "                    } else if ( vname == \"rowSpacing\" ) {",
        "                        rowSpacing = JsonSerializer.Deserialize<double>( msg[i + 1].Buffer);",
        "                    }",
        "                 }",
        "                 if (cropName != \"\") {",
        "                    Plant crop = FindByPath(\"[\" + cropName + \"]\")?.Value as Plant;",
        "                    if (crop == null) { throw new Exception(\"Cant find a component called  '\" + cropName + \"' to sow\"); } ",
        "                    crop.Sow(population:population, cultivar:cultivarName, depth:sowingDepth, rowSpacing:rowSpacing);",
        "                    Console.WriteLine(\"Sowed a {0} crop\", cropName); ",
        "                 }    ",
        "             } else if (cmd == \"harvest\") {",
        "                 string cropName = \"\";",
        "                 for (int i = 2; i < msg.FrameCount; i += 2 ) {",
        "                    var vname = JsonSerializer.Deserialize<string>( msg[i].Buffer);",
        "                    if ( vname == \"crop_name\" ) {",
        "                        cropName = JsonSerializer.Deserialize<string>( msg[i + 1].Buffer);",
        "                    }",
        "                 }",
        "                 if (cropName != \"\") {",
        "                    Plant crop = FindByPath(\"[\" + cropName + \"]\")?.Value as Plant;",
        "                    if (crop == null) { throw new Exception(\"Cant find a component called  '\" + cropName + \"' to harvest\"); }",
        "                    crop.Harvest();",
        "                    Console.WriteLine(\"Harvested a {0} crop\", cropName); ",
        "                 } ",
        "             } else if (cmd == \"irrigate\") {",
        "                 double irrigAmount = 0;",
        "                 for (int i = 2; i < msg.FrameCount; i += 2 ) {",
        "                    var vname = JsonSerializer.Deserialize<string>( msg[i].Buffer);",
        "                    if ( vname == \"amount\" ) {",
        "                        irrigAmount = JsonSerializer.Deserialize<double>( msg[i + 1].Buffer);",
        "                    }",
        "                 }",
        "                 if (irrigAmount > 0) {",
        "                    Irrigation.Apply(amount:irrigAmount, willRunoff:true);",
        "                    Console.WriteLine(\"Irrigated {0} \", irrigAmount, \"mm\"); ",
        "                 }",
        "                 ",
        "             } else if (cmd == \"tillage\") {",
        "                 string implementName = \"\";",
        "                 for (int i = 2; i < msg.FrameCount; i += 2 ) {",
        "                    var vname = JsonSerializer.Deserialize<string>( msg[i].Buffer);",
        "                    if ( vname == \"type\" ) {",
        "                        implementName = JsonSerializer.Deserialize<string>( msg[i + 1].Buffer);",
        "                    }",
        "                 }",
        "                 if ( TillageTypes.ContainsKey(implementName) ) {",
        "                    TillageType tillageType = TillageTypes[implementName];",
        "                    SOM.Incorporate(tillageType.fraction, tillageType.depth);",
        "                    Console.WriteLine(\"Tilled with a {0}\", implementName); ",
        "                 } else {",
        "                    throw new Exception(\"Cant find a tillage method called  '\" + implementName + \"' to till with\");",
        "                 }",
        "             } else if (cmd == \"herbicide\" || cmd == \"weed\") {",
        "                 string weedName = \"\";",
        "                 string weedKillTarget = \"plants\";",
        "                 string weedKillMethod = \"remove\";",
        "                 double weedKillFraction = 0;",
        "                 if (cmd == \"herbicide\") weedKillMethod = \"kill\";",
        "                 for (int i = 2; i < msg.FrameCount; i += 2 ) {",
        "                    var vname = JsonSerializer.Deserialize<string>( msg[i].Buffer);",
        "                    if ( vname == \"weed_name\" ) {",
        "                        weedName = JsonSerializer.Deserialize<string>( msg[i + 1].Buffer);",
        "                    } else if ( vname == \"target_name\" ) {",
        "                        weedKillTarget = JsonSerializer.Deserialize<string>( msg[i + 1].Buffer);",
        "                    } else if ( vname == \"method_name\" ) {",
        "                        weedKillMethod = JsonSerializer.Deserialize<string>( msg[i + 1].Buffer);",
        "                    } else if (vname == \"kill_fraction\" ) {",
        "                        weedKillFraction = JsonSerializer.Deserialize<double>( msg[i + 1].Buffer);",
        "                        if (weedKillFraction < 0) weedKillFraction = 0;",
        "                        else if (weedKillFraction > 1) weedKillFraction = 1;",
        "                    }",
        "                 }",
        "                 if (weedKillMethod == \"manual\" || weedKillMethod == \"manual weeding\") {",
        "                   weedKillMethod = \"remove\";",
        "                 } else if (weedKillMethod == \"chop-and-drop\") {",
        "                   weedKillMethod = \"drop\";",
        "                 } else if (weedKillMethod == \"herbicide\") {",
        "                   weedKillMethod = \"kill\";",
        "                 }",
        "                 if (weedKillTarget == \"leaves\") {",
        "                   weedKillTarget = \"Leaf\";",
        "                 } else if (weedKillTarget == \"nodules\") {",
        "                   weedKillTarget = \"Nodule\";",
        "                 } else if (weedKillTarget == \"roots\") {",
        "                   weedKillTarget = \"Root\";",
        "                 }",
        "                 if (weedName != \"\") {",
        "                    var crop_node = FindByPath(\"[\" + weedName + \"]\");",
        "                    if (crop_node == null) { throw new Exception(\"Cant find a weed called '\" + weedName + \"' to reduce\"); }",
        "                    Plant crop = crop_node.Value as Plant;",
        "                    if (weedKillTarget == \"plants\" || weedKillTarget == \"plant\" || weedKillTarget == \"population\") {",
        "                      double weedPopulationPlants = crop.Population;",
        "                      if (weedKillFraction > 0 && weedPopulationPlants > 0) {",
        "                        if (weedKillMethod == \"remove\") {",
        "                          crop.ReducePopulation(weedPopulationPlants * (1.0 - weedKillFraction));",
        "                          Console.WriteLine(\"Killed {0}% of {1} weed {2}\", 100 * weedKillFraction, weedName, weedKillTarget);",
        "                        } else {",
        "                          var organs = Structure.FindChildren<IHasDamageableBiomass>(recurse: true, relativeTo: crop);",
        "                          foreach (IHasDamageableBiomass organ in organs) {",
        "                            // string organName = organ.Name;",
        "                            if (weedKillMethod == \"drop\") {",
        "                              organ.RemoveBiomass(liveToResidue: weedKillFraction, deadToResidue: weedKillFraction);",
        "                            } else if (weedKillMethod == \"kill\") {",
        "                              organ.RemoveBiomass(liveToResidue: weedKillFraction, fractionStanding: 1.0);",
        "                            } else {",
        "                              throw new Exception(\"Unsupported weed management method_name: \" + weedKillMethod);",
        "                            }",
        "                            Console.WriteLine(\"Killed {0}% of {1} weed {2}\", 100 * weedKillFraction, weedName, organ.Name);",
        "                          }",
        "                        }",
        "                      }",
        "                    } else if (weedKillTarget == \"seeds\" || weedKillTarget == \"seed\") {",
        "                      // TODO: Handle residue from seeds?",
        "                      Manager lifecycle = zone.FindChild(weedName + \"WeedLifecycle\") as Manager;",
        "                      if (lifecycle == null) { throw new Exception(\"Cant find lifecycle module: \" + weedName + \"WeedLifecycle\"); }",
        "                      double weedPopulationSeeds = Convert.ToDouble(lifecycle.GetProperty(\"Population\"));",
        "                      Console.WriteLine(\"weedPopulationSeeds = {0}\", weedPopulationSeeds);",
        "                      if (weedKillFraction > 0 && weedPopulationSeeds > 0) {",
        "                        lifecycle.SetProperty(\"Population\", weedPopulationSeeds * (1 - weedKillFraction));",
        "                        Console.WriteLine(\"Killed {0}% of {1} weed {2}\", 100 * weedKillFraction, weedName, weedKillTarget);",
        "                      }",
        "                    } else if (weedKillFraction > 0) {",
        "                      var organ = crop.FindChild<IHasDamageableBiomass>(weedKillTarget);",
        "                      if (organ == null) { throw new Exception(\"Cant find a damagable organ named '\" + weedKillTarget + \"' to reduce\"); }",
        "                      if (weedKillMethod == \"remove\") {",
        "                        organ.RemoveBiomass(liveToRemove: weedKillFraction, deadToRemove: weedKillFraction);",
        "                      } else if (weedKillMethod == \"drop\") {",
        "                        organ.RemoveBiomass(liveToResidue: weedKillFraction, deadToResidue: weedKillFraction);",
        "                      } else if (weedKillMethod == \"kill\") {",
        "                        organ.RemoveBiomass(liveToResidue: weedKillFraction, fractionStanding: 1.0);",
        "                      } else {",
        "                        throw new Exception(\"Unsupported weed management method_name: \" + weedKillMethod);",
        "                      }",
        "                      // organ.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: 0, deadToResidue: 0.0);",
        "                    }",
        "                 }",
        "             } else if (cmd == \"terminate\") {",
        "                 clock.EndDate = clock.StartDate;",
        "             } else {",
        "                 throw new Exception(\"Unsupported action: \" + cmd);",
        "             }",
        "        }",
        "        ",
        "        ",
        "        private class TillageType {",
        "           public double fraction;",
        "           public double depth;",
        "        }",
        "        [NonSerialized]",
        "        private static readonly Dictionary<string, TillageType> TillageTypes = new Dictionary<string, TillageType> { ",
        "           {\"chisel\", new TillageType { fraction = 0.5, depth = 100 }},",
        "           {\"disc\", new TillageType { fraction =  0.5, depth = 200 }},",
        "           {\"planter\", new TillageType { fraction = 0.1, depth = 50 }}, ",
        "           {\"burn\", new TillageType { fraction = 1.0, depth = 0}}",
        "        };",
        "",
        "        [EventSubscribe(\"EndOfSimulation\")]",
        "        private void OnSimulationEnding(object sender, EventArgs e)",
        "        {",
        "            if (connection == null) { return; }",
        "            ",
        "            Console.WriteLine(\"Finished...\");",
        "            connection.SendFrame(\"finished\");",
        "            var msg = connection.ReceiveFrameString(); ",
        "            if (msg != \"ok\") { throw new Exception(\"Expected ok at end\"); }",
        "            connection.Close();",
        "            ",
        "            Console.WriteLine(\"Simulation Ending\");",
        "        }",
        "        public void RecoverableError(string msg, Exception inner) {",
        "            RecoverableError(msg + inner.ToString());",
        "        }",
        "        public void RecoverableError(string msg) {",
        "            connection.SendFrame(\"recoverable_error\");",
        "            connection.ReceiveFrameString();",
        "            connection.SendFrame(\"paused\");",
        "            Console.WriteLine(msg);",
        "        }",
        "        public void TerminateOnError(string msg) {",
        "            if (connection != null) {",
        "                connection.SendFrame(\"error\");",
        "                connection.ReceiveFrameString();",
        "            }",
        "            throw new Exception(msg);",
        "        }",
        "        public void TerminateOnError(string msg, Exception inner) {",
        "            if (connection != null) {",
        "                connection.SendFrame(\"error\");",
        "                connection.ReceiveFrameString();",
        "            }",
        "            throw new Exception(msg, inner);",
        "        }",
        "",
        "        static bool isNumeric(Type type) {",
        "                         switch (Type.GetTypeCode(type))",
        "                            {",
        "                                case TypeCode.Double:",
        "                                case TypeCode.Single:",
        "                                   return true;",
        "                            }",
        "                            return false;",
        "                        }",
        "                        static bool isInteger(Type type) {",
        "                         switch (Type.GetTypeCode(type))",
        "                            {",
        "                                case TypeCode.Int16:",
        "                                case TypeCode.Int32:",
        "                                case TypeCode.Int64:",
        "                                case TypeCode.UInt16:",
        "                                case TypeCode.UInt32:",
        "                                case TypeCode.UInt64:",
        "                                   return true;",
        "                            }",
        "                            return false;",
        "                        }",
        "                        static bool isString(Type type) {",
        "                         switch (Type.GetTypeCode(type))",
        "                            {",
        "                                case TypeCode.String:",
        "                                   return true;",
        "                            }",
        "                            return false;",
        "                        }       ",
        "   }",
        "}"
    ],
    "Parameters": [
        {
            "Key": "Identifier",
            "Value": "<undefined>"
        }
    ],
    "Name": "Synchroniser",
    "ResourceName": null,
    "Children": [],
    "Enabled": true,
    "ReadOnly": false
}
